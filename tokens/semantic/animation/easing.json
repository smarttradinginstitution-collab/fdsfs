{
  "semantic": {
    "animation": {
      "easing": {
        "enter": { "$value": "{base.animation.easing.in}", "$type": "cubic-bezier" },
        "exit": { "$value": "{base.animation.easing.out}", "$type": "cubic-bezier" },
        "standard": { "$value": "{base.animation.easing.in-out}", "$type": "cubic-bezier" }
      }
    }
  }
}
