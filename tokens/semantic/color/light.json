{
  "color": {
    "surface": {
      "page":    { "$value": "{base.color.gray.50}", "$type": "color" },
      "primary": { "$value": "{base.color.white}", "$type": "color" },
      "secondary": { "$value": "{base.color.gray.100}", "$type": "color" },
      "disabled":{ "$value": "{base.color.gray.100}", "$type": "color" }
    },
    "text": {
      "primary":   { "$value": "{base.color.gray.900}", "$type": "color" },
      "secondary": { "$value": "{base.color.gray.600}", "$type": "color" },
      "tertiary":  { "$value": "{base.color.gray.400}", "$type": "color" },
      "disabled":  { "$value": "{base.color.gray.400}", "$type": "color" },
      "on-brand":  { "$value": "{base.color.white}", "$type": "color" },
      "interactive": { "$value": "{base.color.blue.600}", "$type": "color" }
    },
    "interactive": {
      "primary":   { "default": { "$value": "{base.color.blue.600}", "$type": "color" },
                     "hover":   { "$value": "{base.color.blue.500}", "$type": "color" } },
      "secondary": { "default": { "$value": "{base.color.gray.100}", "$type": "color" },
                     "hover":   { "$value": "{base.color.gray.200}", "$type": "color" } }
    },
    "feedback": {
      "positive": {
        "text": { "$value": "{base.color.green.600}", "$type": "color" },
        "surface": { "$value": "rgba({base.color.green.600-rgb}, 0.1)", "$type": "color" },
        "background-rgb": { "$value": "{base.color.green.600-rgb}", "$type": "color" }
      },
      "negative": {
        "text": { "$value": "{base.color.red.600}", "$type": "color" },
        "surface": { "$value": "rgba({base.color.red.600-rgb}, 0.1)", "$type": "color" },
        "background-rgb": { "$value": "{base.color.red.600-rgb}", "$type": "color" }
      }
    },
    "border": {
      "default":  { "$value": "{base.color.gray.200}", "$type": "color" },
      "subtle":   { "$value": "{base.color.gray.100}", "$type": "color" },
      "focus":    { "$value": "{base.color.blue.500}", "$type": "color" }
    },
    "overlay": {
      "background": { "$value": "{base.color.black-alpha-50}", "$type": "color" }
    }
  }
}
