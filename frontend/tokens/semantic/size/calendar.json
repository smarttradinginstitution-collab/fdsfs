{
  "semantic": {
    "size": {
      "calendar": {
        "card": {
          "padding-inline": {
            "$value": "{base.size.fluid-spacing.lg}",
            "$type": "spacing"
          },
          "padding-block": {
            "$value": "{base.size.fluid-spacing.md}",
            "$type": "spacing"
          }
        },
        "grid": {
          "gap": {
            "$value": "{base.size.fluid-spacing.xxs}",
            "$type": "spacing"
          }
        },
        "day-cell": {
          "padding": {
            "$value": "{base.size.spacing.1}",
            "$type": "spacing",
            "$comment": "Valore statico mantenuto per precisione a piccole dimensioni."
          }
        },
        "controls": {
          "gap": {
            "$value": "{base.size.fluid-spacing.md}",
            "$type": "spacing"
          }
        }
      }
    }
  }
}
