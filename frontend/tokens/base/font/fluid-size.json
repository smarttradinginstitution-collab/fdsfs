{
  "base": {
    "font": {
      "fluid-size": {
        "$comment": "Token per la tipografia fluida, consolidati in una singola funzione clamp().",
        "sm": {
          "$value": "clamp(0.5rem, 0.8vw, 0.65rem)",
          "$type": "fontSize"
        },
        "md": {
          "$value": "clamp(0.6rem, 1.0vw, 0.75rem)",
          "$type": "fontSize"
        },
        "lg": {
          "$value": "clamp(0.7rem, 1.2vw, 0.9rem)",
          "$type": "fontSize"
        },
        "xl": {
          "$value": "clamp(0.7rem, 1.5vw, 1.1rem)",
          "$type": "fontSize"
        },
        "xs": {
          "$value": "clamp(0.6rem, 0.9vw, 0.8rem)",
          "$type": "fontSize"
        },
        "xxs": {
          "$value": "clamp(0.5rem, 0.7vw, 0.65rem)",
          "$type": "fontSize"
        },
        "stat-display": {
          "$value": "clamp(0.9rem, 2vw, 1.2rem)",
          "$type": "fontSize"
        },
        "fluid-heading-xl": {
          "$value": "clamp({base.font.size.lg}, 3vw, {base.font.size.xl})",
          "$type": "fontSize"
        },
        "fluid-heading-sm": {
          "$value": "clamp({base.font.size.sm}, 2vw, {base.font.size.base})",
          "$type": "fontSize"
        },
        "fluid-body-sm": {
          "$value": "clamp({base.font.size.xs}, 1.5vw, {base.font.size.sm})",
          "$type": "fontSize"
        },
        "fluid-label-md": {
          "$value": "clamp({base.font.size.xs}, 1.5vw, {base.font.size.sm})",
          "$type": "fontSize"
        },
        "fluid-calendar-day-header": {
          "$value": "clamp({base.font.size.xxs}, 1.2vw, {base.font.size.xs})",
          "$type": "fontSize"
        },
        "fluid-calendar-day-number": {
          "$value": "clamp({base.font.size.xxs}, 1vw, {base.font.size.xs})",
          "$type": "fontSize"
        },
        "button-label-medium": {
          "$value": "clamp({base.font.size.xs}, 1.5vw, {base.font.size.sm})",
          "$type": "fontSize"
        },
        "button-label-small": {
          "$value": "clamp({base.font.size.xxs}, 1.2vw, {base.font.size.xs})",
          "$type": "fontSize"
        },
        "calendar-pnl-aggressive": {
          "$value": "clamp(0.5rem, 2.5vw, 1.1rem)",
          "$type": "fontSize",
          "$comment": "Scala aggressiva per il P&L nel calendario."
        },
        "calendar-details-aggressive": {
          "$value": "clamp(0.4rem, 1.5vw, 0.7rem)",
          "$type": "fontSize",
          "$comment": "Scala aggressiva per i dettagli nel calendario."
        }
      }
    }
  }
}
