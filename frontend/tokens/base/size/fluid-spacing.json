{
  "base": {
    "size": {
      "fluid-spacing": {
        "xxs": { "$value": "clamp(0.25rem, 0.8vw, 0.375rem)", "$type": "spacing" },
        "xs":  { "$value": "clamp(0.375rem, 1.2vw, 0.5rem)", "$type": "spacing" },
        "sm":  { "$value": "clamp(0.5rem, 1.8vw, 0.75rem)", "$type": "spacing" },
        "md":  { "$value": "clamp(0.75rem, 2.5vw, 1rem)", "$type": "spacing" },
        "lg":  { "$value": "clamp(1rem, 3.5vw, 1.5rem)", "$type": "spacing" },
        "xl":  { "$value": "clamp(1.5rem, 5vw, 2.25rem)", "$type": "spacing" },
        "xxl": { "$value": "clamp(2.25rem, 7vw, 3.5rem)", "$type": "spacing" }
      }
    }
  }
}
